

#BACKEND CONFIGURATION 
BACKEND_PORT=8080
SERVER_PORT=8080

# Database Configuration (for docker-compose local development)
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=shopcart
POSTGRES_PORT=5432

# NOTE: These will be converted by docker-compose to SPRING_DATASOURCE_* environment variables
# See docker-compose.yml for the mapping

#FRONTEND CONFIGURATION
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080/api
VITE_APP_NAME=ShopCart
VITE_APP_VERSION=1.0.0

#CORS & SECURITY
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=Content-Type,Authorization

#LOGGING
LOG_LEVEL=DEBUG

# =====================================================
# RENDER.COM PRODUCTION DEPLOYMENT
# =====================================================
# When deploying to Render.com, set these environment variables in the Render dashboard:
# SPRING_DATASOURCE_URL=jdbc:postgresql://hostname:5432/dbname
# SPRING_DATASOURCE_USERNAME=your_db_user
# SPRING_DATASOURCE_PASSWORD=your_db_password
# SPRING_PROFILES_ACTIVE=prod
# PORT=8080 (or your desired port)
